# Local Homebrew / Herd Postgres (same pattern as spa/ops)
# createdb assembla_med
DATABASE_URL="postgresql://terryturner@localhost:5432/assembla_med?schema=public"

PORT=4000
CORS_ORIGIN=http://localhost:3018
COOKIE_SECURE=false
SESSION_DAYS=14
STORAGE_ROOT=./storage

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Assembla Med <noreply@example.com>
# When set, all outbound mail is redirected here (safe local testing)
MAILGUN_TEST_TO=tdturn2@gmail.com
# When true, skip provider call and mark sends as dry-run success
MAILGUN_DRY_RUN=false
PUBLIC_WEB_URL=http://localhost:3018
PUBLIC_API_URL=http://localhost:4000/api
