# Assembla Med Web — build from repo root
# Settings → Dockerfile path: Dockerfile.web (or railway.web.toml)
# Clear Custom Start Command in Railway (use this CMD only).

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@11.13.1 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
# api postinstall needs prisma; web postinstall (nuxt prepare) needs more — ignore scripts here
COPY apps/api/prisma apps/api/prisma/
RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm --filter @assembla-med/api exec prisma generate

FROM deps AS build
ARG NUXT_PUBLIC_API_BASE=http://localhost:4000/api
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE
COPY . .
RUN pnpm --filter @assembla-med/shared build \
  && pnpm --filter @assembla-med/web build \
  && test -f apps/web/.output/server/index.mjs

FROM base AS runner
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV NITRO_HOST=0.0.0.0
WORKDIR /app/apps/web
COPY --from=build /app /app
EXPOSE 8080
# Do NOT pass --host 0.0.0.0 — Nuxt treats it as a rootDir path.
CMD ["sh", "-c", "node .output/server/index.mjs"]
