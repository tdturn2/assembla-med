# Assembla Med Web — build from repo root
# Settings → Dockerfile path: Dockerfile.web

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG NUXT_PUBLIC_API_BASE=http://localhost:4000/api
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE
COPY . .
RUN pnpm --filter @assembla-med/shared build \
  && pnpm --filter @assembla-med/web build

FROM base AS runner
ENV NODE_ENV=production
ENV HOST=0.0.0.0
COPY --from=build /app /app
EXPOSE 8080
CMD ["sh", "-c", "pnpm --filter @assembla-med/web exec nuxt preview --host 0.0.0.0 --port ${PORT:-8080}"]
